{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mixero",
  "version": "1.0.0",
  "identifier": "com.mixero.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mixero",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": true,
        "theme": "Dark"
      },
      {
        "label": "quick",
        "title": "Mixero Quick Mixer",
        "url": "index.html#/quick",
        "width": 372,
        "height": 430,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "theme": "Dark"
      },
      {
        "label": "tray",
        "title": "Mixero Menu",
        "url": "index.html#/tray",
        "width": 240,
        "height": 170,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
